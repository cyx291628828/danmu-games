# 依赖（npm install 后生成，见 package.json）
node_modules/

# 打包产物（一键打包.bat / node scripts/package.js 输出）
dist/

# 运行时数据：玩家排行榜 / 红蓝赛季名册（含真实观众昵称与头像，不入库；首次运行自动生成）
data/*
!data/.gitkeep

# 日志
log/
*.log

# 宿主运行时状态（端口 / 激活游戏 / 主题 / 游戏开关，宿主自动写入）
host/host.json

# GUI 测试截图与工具产物
gui-test-screenshots/
.mimosa/

# 备份与临时文件
*.bak
*.back
*.tmp
# 语义猜词模型：Volume 过大（单个 >100MB，超过 GitHub 单文件上限），且均为可再生成产物，不入库。
# 获取方式见 games/semantic/README.md：下载源词向量后执行
#   node scripts/gen_semantic_model.cjs <word2vec二进制文件>
games/semantic/model/source/light_Tencent_AILab_ChineseEmbedding.bin
games/semantic/model/vectors.f32
